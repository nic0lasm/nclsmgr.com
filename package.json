{
  "name": "nclsmgr.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:courrier": "esbuild courrier=src/courrier/index.ts liens=src/courrier/liens.ts --bundle --platform=node --target=node24 --format=cjs --conditions=react-server --external:better-sqlite3 --outdir=dist --out-extension:.js=.cjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "apercu": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generer-apercu.mts",
    "instantane": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/instantane-github.mts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "next": "16.4.2",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "typescript": "^6",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  }
}
