{
	admin off
	servers {
		import /etc/caddy/cloudflare-ips.caddy
		client_ip_headers CF-Connecting-IP
		# Des en-têtes qui traînent ne tiennent pas une connexion ; pas de délai de lecture du
		# corps, qui couperait les websockets du jeu.
		timeouts {
			read_header 10s
			idle 2m
		}
		max_header_size 16KB
	}
}

(securite) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-Via
	}
}

www.nclsmgr.com {
	tls /certs/origin.pem /certs/origin-key.pem
	import securite
	redir https://nclsmgr.com{uri} permanent
}

nclsmgr.com {
	tls /certs/origin.pem /certs/origin-key.pem
	import securite
	encode zstd gzip

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Espace privé : ni cache ni indexation, et aucun Referer vers l'extérieur.
	# Le préfixe > écrit l'en-tête à la réponse et remplace la valeur du bloc securite.
	# same-origin et non no-referrer : les POST gardent un Origin pour le contrôle anti-CSRF.
	@acces {
		path /fr/p /en/p /fr/p/* /en/p/*
		not path /fr/p/acces /en/p/acces
	}
	header @acces {
		>Cache-Control "no-store"
		>X-Robots-Tag "noindex, nofollow, noarchive"
		>Referrer-Policy "same-origin"
	}

	@espace {
		path /fr/espace /en/espace /fr/espace/* /en/espace/*
		not path /fr/espace/sortie /en/espace/sortie
	}
	header @espace {
		>Cache-Control "private, no-store"
		>X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		>Referrer-Policy "same-origin"
	}

	# Documents réservés : politique fermée, même si l'application l'oubliait.
	@documents path /fr/espace/documents/* /en/espace/documents/*
	header @documents >Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; sandbox allow-downloads"

	@routes path /fr/p/acces /en/p/acces /fr/espace/sortie /en/espace/sortie
	header @routes {
		>Cache-Control "no-store"
		>X-Robots-Tag "noindex"
	}

	# Politique de repli, posée seulement si l'application n'en met pas : le proxy Next.js
	# saute les requêtes marquées prefetch, qui recevraient sinon une page HTML sans CSP.
	# Sans nonce, aucun script ne s'exécute.
	header ?Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

	# Next.js ne doit jamais recevoir cet en-tête interne depuis l'extérieur (famille CVE-2025-29927).
	request_header -X-Middleware-Subrequest
	# Nonce et politique de la requête : seul le proxy Next.js les pose, en interne. Une requête
	# marquée prefetch ne passe pas par lui : elle ne doit pas pouvoir imposer les siens au rendu.
	# Next.js lit le nonce dans la politique, ou à défaut dans sa variante Report-Only.
	request_header -X-Nonce
	request_header -Content-Security-Policy
	request_header -Content-Security-Policy-Report-Only

	# Pays du visiteur : seulement si la requête vient de Cloudflare (trusted_proxies).
	@horsCloudflare not vars trusted_proxy true
	request_header @horsCloudflare -CF-IPCountry

	# Mesure d'audience : seuls le script et la collecte sont publics, jamais le tableau de bord.
	@statistiques path /stats/script.js /stats/api/send
	handle @statistiques {
		uri strip_prefix /stats
		reverse_proxy umami:3000 {
			# Umami lit d'abord cet en-tête : on impose l'IP vue par Caddy derrière Cloudflare.
			header_up CF-Connecting-IP {client_ip}
		}
	}

	# Frontfall, jeu multijoueur publié par son propre dépôt (nic0lasm/frontfall) dans un projet
	# Compose distinct ; Caddy le joint sur le réseau frontfall. Le jeu ignore son préfixe : ses
	# ressources sont relatives et le websocket se trouve sous /frontfall/ws. Sa politique admet en
	# plus le script de mesure d'audience que Cloudflare injecte dans les pages, et son envoi.
	redir /frontfall /frontfall/ permanent
	@frontfall path /frontfall/*
	header @frontfall >Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://nclsmgr.com https://cloudflareinsights.com; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
	# Les fichiers de assets/ portent leur empreinte dans leur nom ; le reste se revalide.
	@frontfallAssets path /frontfall/assets/*
	header @frontfallAssets >Cache-Control "public, max-age=31536000, immutable"
	@frontfallPages {
		path /frontfall/*
		not path /frontfall/assets/*
	}
	header @frontfallPages >Cache-Control "no-cache"
	# Les métriques et l'administration du jeu restent sur le serveur, même si le jeu cessait de
	# les refuser.
	@frontfallPrive path /frontfall/metrics* /frontfall/admin* /frontfall-next/metrics* /frontfall-next/admin*
	handle @frontfallPrive {
		respond 404
	}
	handle /frontfall/* {
		uri strip_prefix /frontfall
		# Le jeu n'accepte que de petits corps JSON (8 Ko au plus) ; les trames du websocket ne
		# sont pas concernées.
		request_body {
			max_size 64KB
		}
		reverse_proxy frontfall:8080 {
			header_up X-Client-IP {client_ip}
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}

	# Préproduction du jeu (branche next), même politique, sur son propre conteneur.
	redir /frontfall-next /frontfall-next/ permanent
	@frontfallNext path /frontfall-next/*
	header @frontfallNext >Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://nclsmgr.com https://cloudflareinsights.com; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
	header @frontfallNext >X-Robots-Tag "noindex"
	@frontfallNextAssets path /frontfall-next/assets/*
	header @frontfallNextAssets >Cache-Control "public, max-age=31536000, immutable"
	@frontfallNextPages {
		path /frontfall-next/*
		not path /frontfall-next/assets/*
	}
	header @frontfallNextPages >Cache-Control "no-cache"
	handle /frontfall-next/* {
		uri strip_prefix /frontfall-next
		# Le jeu n'accepte que de petits corps JSON (8 Ko au plus) ; les trames du websocket ne
		# sont pas concernées.
		request_body {
			max_size 64KB
		}
		reverse_proxy frontfall-next:8080 {
			header_up X-Client-IP {client_ip}
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			# Seul en-tête d'IP client lu par l'application ; jamais X-Forwarded-For.
			header_up X-Client-IP {client_ip}
		}
	}
}

# Tableau de bord Umami, publié sur la boucle locale du serveur seulement (tunnel SSH).
http://:3001 {
	reverse_proxy umami:3000
}
