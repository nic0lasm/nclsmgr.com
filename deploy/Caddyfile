{
	admin off
	servers {
		import /etc/caddy/cloudflare-ips.caddy
		client_ip_headers CF-Connecting-IP
	}
}

(securite) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
}

www.nclsmgr.com {
	tls /certs/origin.pem /certs/origin-key.pem
	import securite
	redir https://nclsmgr.com{uri} permanent
}

nclsmgr.com {
	tls /certs/origin.pem /certs/origin-key.pem
	import securite
	encode zstd gzip

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Espace privé : ni cache ni indexation, et aucun Referer vers l'extérieur.
	# Le préfixe > écrit l'en-tête à la réponse et remplace la valeur du bloc securite.
	# same-origin et non no-referrer : les POST gardent un Origin pour le contrôle anti-CSRF.
	@acces {
		path /fr/p /en/p /fr/p/* /en/p/*
		not path /fr/p/acces /en/p/acces
	}
	header @acces {
		>Cache-Control "no-store"
		>X-Robots-Tag "noindex, nofollow, noarchive"
		>Referrer-Policy "same-origin"
	}

	@espace {
		path /fr/espace /en/espace /fr/espace/* /en/espace/*
		not path /fr/espace/sortie /en/espace/sortie
	}
	header @espace {
		>Cache-Control "private, no-store"
		>X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		>Referrer-Policy "same-origin"
	}

	@routes path /fr/p/acces /en/p/acces /fr/espace/sortie /en/espace/sortie
	header @routes {
		>Cache-Control "no-store"
		>X-Robots-Tag "noindex"
	}

	# Next.js ne doit jamais recevoir cet en-tête interne depuis l'extérieur (famille CVE-2025-29927).
	request_header -X-Middleware-Subrequest

	# Pays du visiteur : seulement si la requête vient de Cloudflare (trusted_proxies).
	@horsCloudflare not vars trusted_proxy true
	request_header @horsCloudflare -CF-IPCountry

	# Mesure d'audience : seuls le script et la collecte sont publics, jamais le tableau de bord.
	@statistiques path /stats/script.js /stats/api/send
	handle @statistiques {
		uri strip_prefix /stats
		reverse_proxy umami:3000 {
			# Umami lit d'abord cet en-tête : on impose l'IP vue par Caddy derrière Cloudflare.
			header_up CF-Connecting-IP {client_ip}
		}
	}

	handle {
		reverse_proxy web:3000 {
			# Seul en-tête d'IP client lu par l'application ; jamais X-Forwarded-For.
			header_up X-Client-IP {client_ip}
		}
	}
}

# Tableau de bord Umami, publié sur la boucle locale du serveur seulement (tunnel SSH).
http://:3001 {
	reverse_proxy umami:3000
}
